<Project>
  <!-- Every test run records a .trx (see test.runsettings): a failure keeps its name even when it
       will not reproduce. Ad-hoc runs kept forgetting the flag; the harness must not be forgettable. -->
  <PropertyGroup>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)test.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <!-- ImageSharp stays on 3.1.x: the release that fixes these advisories (3.2.0) fails Release builds
       without a Six Labors license key. The app encodes no TIFF and runs no histogram equalization; the
       TIFF and ICC decoder advisories need a crafted file the modder picks, and no picker offers TIFF.
       Each advisory is named, so a new one still warns. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>
</Project>
