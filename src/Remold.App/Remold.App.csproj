<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- The About dialog reports Assembly.GetName().Version, so these are what a user quotes in a
         bug report; keep all three in step with Core's. -->
    <Version>0.4.1</Version>
    <AssemblyVersion>0.4.1.0</AssemblyVersion>
    <FileVersion>0.4.1.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Avalonia.BuildServices ships only a build-time telemetry task (AvaloniaStats); excluding its assets keeps the
         build from phoning home and from writing under AppData, which a sandboxed build cannot do -->
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Remold.Core\Remold.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Remold.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- ship the Blender bridge script next to the exe so OpenInBlender can launch it -->
    <Content Include="..\..\blender\remold_bridge.py" Link="blender\remold_bridge.py"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- the shipped asset-sharing measurement (LabPaths.SharingSeedFile) -->
    <Content Include="..\..\data\sharing_seed.json" Link="data\sharing_seed.json"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- its observation memo, minted from the same pass (LabPaths.AssetHashSeedFile) -->
    <Content Include="..\..\data\asset_hashes_seed.json" Link="data\asset_hashes_seed.json"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- the shipped shader slot catalog (LabPaths.ShaderSlotCatalogFile) -->
    <Content Include="..\..\data\charps_slots.json" Link="data\charps_slots.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
