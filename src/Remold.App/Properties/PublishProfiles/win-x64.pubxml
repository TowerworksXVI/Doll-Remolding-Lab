<?xml version="1.0" encoding="utf-8"?>
<!--
  The RELEASE publish profile: the self-contained win-x64 build that goes in the release zip. Output
  lands in out\publish\win-x64 at the repo root (gitignored), and the whole FOLDER is the release: the
  app creates mod folders beside itself, so a folder is its natural shape.

  Single-file is not available. The texture encoder's DirectXTex assembly is mixed-mode, and a
  mixed-mode assembly cannot load out of a single-file bundle. IncludeNativeLibrariesForSelfExtract
  would not rescue it either, and its extract-to-temp trips AV heuristics.

  Trimming stays OFF. Avalonia resolves controls, themes and converters reflectively and the app's own
  JSON round-trips are reflection-based, so a trimmed build loses types no static analysis can see.

  The Blender bridge script ships next to the exe via the project's Content include; the app also needs
  a game install, Blender and a 3DMigoto install at runtime.

  Build it with:   dotnet publish src/Remold.App -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>..\..\out\publish\win-x64</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
