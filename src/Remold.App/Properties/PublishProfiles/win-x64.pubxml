<?xml version="1.0" encoding="utf-8"?>
<!--
  The RELEASE publish profile: the self-contained win-x64 build. Output lands in out\publish\win-x64 at
  the repo root (gitignored). The release zip is NOT this flat folder — it is the PACKED layout
  tools\PackRelease produces from it: the exe alone at the root (with the mods library and settings
  created beside it at run time) and every other file under app\. The root exe is an apphost whose
  embedded app path points into app\.

  Single-file is not available. The texture encoder's DirectXTex assembly is mixed-mode, and a
  mixed-mode assembly cannot load out of a single-file bundle. IncludeNativeLibrariesForSelfExtract
  would not rescue it either, and its extract-to-temp trips AV heuristics. The packed layout has
  neither problem: nothing is bundled, the assemblies just live one folder down.

  Trimming stays OFF. Avalonia resolves controls, themes and converters reflectively and the app's own
  JSON round-trips are reflection-based, so a trimmed build loses types no static analysis can see.

  The Blender bridge script ships next to the assemblies via the project's Content include; the app
  also needs a game install, Blender and a 3DMigoto install at runtime.

  Build it with:   dotnet publish src/Remold.App -p:PublishProfile=win-x64
  Then pack it with tools\PackRelease, handing it out\publish\win-x64 and a fresh output folder
  (usage line in its Program.cs header).
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>..\..\out\publish\win-x64</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
