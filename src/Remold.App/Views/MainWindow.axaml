<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Remold.App.ViewModels"
        xmlns:views="using:Remold.App.Views"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="Remold.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1200" Height="800"
        MinWidth="920" MinHeight="480"
        Background="{StaticResource HudBgBrush}"
        Icon="/Assets/icon.ico"
        Title="Doll Remolding Lab">

  <Window.Resources>
    <views:StringEqualsConverter x:Key="StrEq" />
  </Window.Resources>

  <Window.Styles>
    <!-- Recent-mods rows (home screen). The default FluentTheme Button chrome highlighted inconsistently on
         click; pin every interaction state to the HUD brushes on the row's own ContentPresenter so ONLY the
         hovered/pressed row lights (there is no per-row selection state — each row is an independent Button). -->
    <Style Selector="Button.recent /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Button.recent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource HudPanelAltBrush}" />
    </Style>
    <Style Selector="Button.recent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource HudBorderBrush}" />
    </Style>


    <!-- shared pulsing throbber dot (a background scan or export in flight) -->
    <Style Selector="TextBlock.pulse">
      <Setter Property="Foreground" Value="{StaticResource HudAccentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ===== Header ===== -->
    <Border Grid.Row="0" Background="{StaticResource HudPanelBrush}"
            BorderBrush="{StaticResource HudBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
        <TextBlock Grid.Column="0" Text="DOLL REMOLDING LAB" FontWeight="Bold" FontSize="16"
                   Foreground="{StaticResource HudAccentBrush}" VerticalAlignment="Center" />

        <!-- Menu bar: the mod is a first-class object. Boxed + highlighted so it reads as a real
             menu bar rather than a lone word. File/Tools/Help are all live. -->
        <Border Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                Background="{StaticResource HudPanelAltBrush}" BorderBrush="{StaticResource HudBorderBrush}"
                BorderThickness="1" CornerRadius="4">
          <Menu Background="Transparent" VerticalAlignment="Center">
            <Menu.Styles>
              <Style Selector="Menu > MenuItem">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource HudTextBrush}" />
              </Style>
            </Menu.Styles>
            <MenuItem Header="File">
              <MenuItem Header="New mod…" Click="OnNewMod" />
              <MenuItem Header="Open mod…" Click="OnOpenMod" />
              <MenuItem Header="Open recent" Name="RecentMenu" ItemsSource="{Binding RecentMods}"
                        IsEnabled="{Binding HasRecentMods}">
                <MenuItem.ItemTemplate>
                  <DataTemplate x:DataType="vm:RecentModVm">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </MenuItem.ItemTemplate>
                <!-- each generated child is a real command item: binding its Command (not a bubbled Click on
                     the submenu parent) is what makes Avalonia dismiss the menu on click.
                     Scope to RecentMenu's CHILDREN by name: a bare "MenuItem > MenuItem" also matches Open
                     Recent itself (a MenuItem under the File MenuItem), which would give the header the typed
                     RecentMod command with the VM as its parameter and crash CanExecute when File opens. -->
                <MenuItem.Styles>
                  <Style Selector="MenuItem#RecentMenu > MenuItem" x:DataType="vm:RecentModVm">
                    <Setter Property="Command"
                            Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenRecentCommand}" />
                    <Setter Property="CommandParameter" Value="{Binding}" />
                  </Style>
                </MenuItem.Styles>
              </MenuItem>
              <Separator />
              <MenuItem Header="Save mod" Command="{Binding SaveModCommand}" IsEnabled="{Binding !ShowHome}" />
              <MenuItem Header="Save mod as…" Click="OnSaveModAs" IsEnabled="{Binding !ShowHome}" />
              <MenuItem Header="Close mod" Command="{Binding CloseModCommand}" IsEnabled="{Binding !ShowHome}" />
            </MenuItem>
            <MenuItem Header="Tools">
              <!-- the tooltip is where the OTHER rescan lives: this one re-reads the install and keeps every
                   rebuilt cache, and the variant that drops them is a Settings row nobody would go looking
                   for from here -->
              <MenuItem Header="Rescan game files" Command="{Binding ReloadRosterCommand}"
                        IsEnabled="{Binding !IsScanning}"
                        ToolTip.Tip="Re-reads the game files and keeps the rebuilt caches. Settings · Force rescan clears the caches as well." />
              <MenuItem Header="Locate game…" Click="OnLocateGame" />
              <MenuItem Header="Settings…" Click="OnSettings" />
            </MenuItem>
            <MenuItem Header="Help">
              <MenuItem Header="About Doll Remolding Lab" Click="OnAbout" />
            </MenuItem>
          </Menu>
        </Border>

        <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource HudSubtextBrush}" IsVisible="{Binding !ShowHome}">
          <Run Text="Current mod:" />
          <Run Text="{Binding ModTitleDisplay}" Foreground="{StaticResource HudTextBrush}" FontWeight="SemiBold" />
        </TextBlock>
        <!-- the launch's own line, beside the button that causes it: the status bar's notice cell carries
             the load's warnings, and a launch must not overwrite them. Glyphless while a stage is in
             flight, glyphed when it lands; the label is capped, so the tooltip leads with the whole line and
             the detail follows it. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="12,0"
                    VerticalAlignment="Center" HorizontalAlignment="Right"
                    IsVisible="{Binding LaunchStatus.HasText}"
                    ToolTip.Tip="{Binding LaunchStatus.Tip}">
          <!-- a glyphless facet is a stage still running (the permission prompt gets up to a minute), so it
               carries the app's pulsing throbber where a landed one carries its ✓ / ✗ -->
          <TextBlock Classes="pulse" Text="◌" IsVisible="{Binding !LaunchStatus.HasGlyph}" />
          <TextBlock Text="{Binding LaunchStatus.Glyph}" Foreground="{Binding LaunchStatus.Color}"
                     IsVisible="{Binding LaunchStatus.HasGlyph}" />
          <TextBlock Text="{Binding LaunchStatus.Text}" Foreground="{Binding LaunchStatus.Color}"
                     FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="320" />
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !ShowHome}">
          <Button Content="⌂ Home" Command="{Binding CloseModCommand}"
                  ToolTip.Tip="Close this mod and return to the start screen" />
          <Button Content="Save" Command="{Binding SaveModCommand}" />
        </StackPanel>
        <!-- Settings and launching belong to the app, not to a mod, so they stand outside the per-mod
             buttons and show on the start screen too. Tools · Settings… opens the same dialog.
             Launch disabled says which half is missing (ShowOnDisabled). -->
        <Button Grid.Column="5" Content="⚙ Settings" Margin="8,0,0,0" VerticalAlignment="Center"
                Click="OnSettings" />
        <Button Grid.Column="6" Content="▶ Launch game" Margin="8,0,0,0" VerticalAlignment="Center"
                Command="{Binding LaunchGameCommand}" IsEnabled="{Binding CanLaunchGame}"
                ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding LaunchButtonTip}" />
      </Grid>
    </Border>

    <!-- ===== Body: left rail + main pane (hidden on the home screen) ===== -->
    <Grid Grid.Row="1" ColumnDefinitions="180,*" IsVisible="{Binding !ShowHome}">

      <!-- left rail -->
      <Border Grid.Column="0" Background="{StaticResource HudPanelBrush}"
              BorderBrush="{StaticResource HudBorderBrush}" BorderThickness="0,0,1,0">
        <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                 Background="Transparent" Margin="0,8" Padding="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" FontSize="14" Padding="10,8" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- main pane -->
      <Panel Grid.Column="1" Margin="16">

        <!-- PICK -->
        <Grid RowDefinitions="Auto,*,Auto"
              IsVisible="{Binding SelectedStep, Converter={StaticResource StrEq}, ConverterParameter='① Pick'}">
          <StackPanel Grid.Row="0" Margin="0,0,0,10" Spacing="3">
            <TextBlock Text="Pick" FontSize="15"
                       Foreground="{StaticResource HudTextBrush}" />
            <!-- Honest cue: unlock is PROGRESSIVE — each character's checkbox lights up as the scan confirms
                 that character, not all-at-once when the scan finishes. -->
            <TextBlock IsVisible="{Binding IsScanning}" Foreground="{StaticResource HudSubtextBrush}"
                       FontSize="12" TextWrapping="Wrap"
                       Text="Reading game files. Characters become available as they're found." />
          </StackPanel>

          <!-- Three roster tabs over the same live roster (all TreeViews over CharacterVm): the playable
               characters, the enemies/NPCs, and the weapons. -->
          <TabControl Grid.Row="1" Padding="0">

            <!-- Shared by every roster grid below — all are TreeViews over CharacterVm. -->
            <TabControl.Styles>
              <!-- multi-outfit character groups are default-COLLAPSED: each CharacterVm's IsExpanded (false by
                   default) drives its row two-way; reflection binding tolerates a leaf row whose VM lacks the
                   property (it falls back to collapsed, which a leaf ignores). -->
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay, FallbackValue=False}" />
              </Style>
            </TabControl.Styles>
            <TabControl.DataTemplates>
              <!-- Subject-level Pick (S9 inc4): each row is a picked SUBJECT (outfit) with ONE checkbox —
                   in the mod / not. Checking adds the ledger entry; unchecking removes the subject (confirm +
                   revert on cancel, in the VM). A subject with edits shows a single ✎. Singleton levels
                   collapse: a one-outfit character's row IS the subject (its checkbox); a multi-outfit
                   character is a header whose outfit rows each carry a checkbox. Double-click opens it in Edit
                   (the window's tunnel handler → OpenSubjectInEdit, which checks it first). -->
              <TreeDataTemplate DataType="vm:CharacterVm" ItemsSource="{Binding TreeChildren}">
                <Panel>
                  <!-- collapsed single-outfit subject: the character row carries the checkbox (proxies the one outfit) -->
                  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowSubjectBox}"
                              Opacity="{Binding NameOpacity}" VerticalAlignment="Center">
                    <CheckBox IsThreeState="False" IsChecked="{Binding SubjectInMod}">
                      <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource HudTextBrush}" FontWeight="SemiBold" />
                    </CheckBox>
                    <!-- weapon-tier badge (R / SR / SSR) in its tier color -->
                    <TextBlock Text="{Binding SubjectBadge}" Foreground="{Binding SubjectBadgeBrush}"
                               FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                               IsVisible="{Binding HasSubjectBadge}" />
                    <TextBlock Text="{Binding TreeDetail}" Foreground="{StaticResource HudSubtextBrush}"
                               FontSize="11" VerticalAlignment="Center" IsVisible="{Binding HasTreeDetail}" />
                    <TextBlock Text="✎" Foreground="{StaticResource HudAccentBrush}" FontSize="12"
                               VerticalAlignment="Center" IsVisible="{Binding SubjectHasEdits}"
                               ToolTip.Tip="Has edits in this mod." />
                  </StackPanel>
                  <!-- multi-outfit character: a grouping header that ALSO carries a character-level checkbox
                       (F3, "grab an entire character at once"). Tri-state: checked = all outfits in,
                       unchecked = none, dash = mixed (display only — a click from any state adds all). Its
                       outfit rows still carry their own checkboxes underneath. -->
                  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowGroupHeader}"
                              Opacity="{Binding NameOpacity}" VerticalAlignment="Center">
                    <CheckBox IsThreeState="True" IsChecked="{Binding CharacterInMod}"
                              ToolTip.Tip="Add or remove all of this character's outfits at once.">
                      <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource HudTextBrush}" FontWeight="SemiBold" />
                    </CheckBox>
                    <TextBlock Text="✎" Foreground="{StaticResource HudAccentBrush}" FontSize="12"
                               VerticalAlignment="Center" IsVisible="{Binding CharacterHasEdits}"
                               ToolTip.Tip="Some of this character's outfits have edits in this mod." />
                  </StackPanel>
                  <!-- loading: plain label, no checkbox (nothing to pick until the scan resolves the outfits) -->
                  <TextBlock Text="{Binding DisplayName}" IsVisible="{Binding IsLoading}" Opacity="{Binding NameOpacity}"
                             Margin="4,0,0,0" VerticalAlignment="Center"
                             Foreground="{StaticResource HudTextBrush}" FontWeight="SemiBold" />
                </Panel>
              </TreeDataTemplate>
              <!-- OutfitVm is always a LEAF (parts aren't picked here), so no ItemsSource — the dead Children
                   binding was removed with the property. -->
              <TreeDataTemplate DataType="vm:OutfitVm">
                <Panel>
                  <!-- ready: the subject checkbox (in the mod / not) + ✎ when it has edits -->
                  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowSubjectBox}"
                              VerticalAlignment="Center">
                    <CheckBox IsThreeState="False" IsChecked="{Binding IsInMod}">
                      <TextBlock Text="{Binding Label}" Foreground="{StaticResource HudAmberBrush}" />
                    </CheckBox>
                    <!-- weapon-tier badge (R / SR / SSR) in its tier color -->
                    <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeBrush}"
                               FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                               IsVisible="{Binding HasBadge}" />
                    <TextBlock Text="✎" Foreground="{StaticResource HudAccentBrush}" FontSize="12"
                               VerticalAlignment="Center" IsVisible="{Binding HasEdits}"
                               ToolTip.Tip="Has edits in this mod." />
                  </StackPanel>
                  <!-- loading: plain label + hint, no checkbox (we can't act on it until the scan reaches it) -->
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLoading}"
                              Margin="4,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource HudAmberBrush}" />
                    <TextBlock Text="Loading…" Foreground="{StaticResource HudSubtextBrush}"
                               FontStyle="Italic" FontSize="11" VerticalAlignment="Center" />
                  </StackPanel>
                </Panel>
              </TreeDataTemplate>
            </TabControl.DataTemplates>

            <!-- ===== Characters — the outfit roster (subject picker) =====
                 The Outfits/Animations inner mode switch retired in S9 inc4: the Pick "Animations" tab is
                 gone. Double-click a subject to open it in Edit (checks it first). -->
            <TabItem Header="{Binding CharactersTabHeader}">
              <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                <TextBox Grid.Row="0" Watermark="Filter characters" Text="{Binding SearchText}"
                         Margin="0,0,0,10" />
                <Border Grid.Row="1" Background="{StaticResource HudPanelBrush}"
                        BorderBrush="{StaticResource HudBorderBrush}" BorderThickness="1" CornerRadius="3">
                  <Panel>
                    <TextBlock Text="Reading game files…" Margin="14"
                               Foreground="{StaticResource HudSubtextBrush}"
                               IsVisible="{Binding IsLoading}" />
                    <!-- a search that matched nothing: the box says so instead of standing empty -->
                    <TextBlock Text="{Binding CharactersNoMatch}" Margin="14" TextWrapping="Wrap"
                               Foreground="{StaticResource HudSubtextBrush}"
                               IsVisible="{Binding HasCharactersNoMatch}" />
                    <TreeView ItemsSource="{Binding Characters}" Background="Transparent" Padding="6" />
                  </Panel>
                </Border>
              </Grid>
            </TabItem>

            <!-- ===== Enemies — the enemy-model roster (subject picker): EnemyData names joined to
                 their models, one row per enemy; picks feed the same queue/ledger as Characters. ===== -->
            <TabItem Header="{Binding EnemiesTabHeader}">
              <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                <TextBox Grid.Row="0" Watermark="Filter enemies" Text="{Binding EnemySearchText}"
                         Margin="0,0,0,10" />
                <Border Grid.Row="1" Background="{StaticResource HudPanelBrush}"
                        BorderBrush="{StaticResource HudBorderBrush}" BorderThickness="1" CornerRadius="3">
                  <Panel>
                    <TextBlock Text="Reading game files…" Margin="14"
                               Foreground="{StaticResource HudSubtextBrush}"
                               IsVisible="{Binding IsLoading}" />
                    <!-- a search that matched nothing, plus where a filtered duplicate door went: the tab
                         lists an enemy under the character whose meshes it reuses, and a hole the modder
                         can't explain is worse than the sentence -->
                    <StackPanel Margin="14" Spacing="6" IsVisible="{Binding HasEnemiesNoMatch}">
                      <TextBlock Text="{Binding EnemiesNoMatch}" TextWrapping="Wrap"
                                 Foreground="{StaticResource HudSubtextBrush}" />
                      <TextBlock Text="{Binding EnemiesNoMatchNote}" TextWrapping="Wrap" FontSize="11"
                                 Foreground="{StaticResource HudSubtextBrush}" />
                    </StackPanel>
                    <TreeView ItemsSource="{Binding Enemies}" Background="Transparent" Padding="6" />
                  </Panel>
                </Border>
              </Grid>
            </TabItem>

            <!-- ===== Weapons — weapon groups per owner character (R/SR/SSR badges, plus the Battle Pass
                 loose group), then the per-type standalone-skin groups. A skin applies to any weapon of
                 its type, so skins are their own subjects, not variants under a weapon. ===== -->
            <TabItem Header="{Binding WeaponsTabHeader}">
              <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                <TextBox Grid.Row="0" Watermark="Filter weapons" Text="{Binding WeaponSearchText}"
                         Margin="0,0,0,10" />
                <Border Grid.Row="1" Background="{StaticResource HudPanelBrush}"
                        BorderBrush="{StaticResource HudBorderBrush}" BorderThickness="1" CornerRadius="3">
                  <Panel>
                    <TextBlock Text="Reading game files…" Margin="14"
                               Foreground="{StaticResource HudSubtextBrush}"
                               IsVisible="{Binding IsLoading}" />
                    <TextBlock Text="{Binding WeaponsNoMatch}" Margin="14" TextWrapping="Wrap"
                               Foreground="{StaticResource HudSubtextBrush}"
                               IsVisible="{Binding HasWeaponsNoMatch}" />
                    <TreeView ItemsSource="{Binding Weapons}" Background="Transparent" Padding="6" />
                  </Panel>
                </Border>
              </Grid>
            </TabItem>

          </TabControl>

          <!-- footer (S9 inc4): no Add/queue — Pick just selects subjects. A subject is authored in Edit
               (double-click a row, or check it and press Next). -->
          <Grid Grid.Row="2" Margin="0,10,0,0" ColumnDefinitions="*,Auto">
            <Border Grid.Column="0" Padding="10,8" CornerRadius="3" VerticalAlignment="Stretch"
                    Margin="0,0,12,0" Background="{StaticResource HudPanelAltBrush}">
              <TextBlock VerticalAlignment="Center" Foreground="{StaticResource HudSubtextBrush}" TextWrapping="Wrap"
                         Text="Check the items to include in this mod. Double-click a row to open it in ② Edit." />
            </Border>
            <Button Grid.Column="1" Content="Next: Edit ▸" Command="{Binding GoToEditCommand}" Classes="primary"
                    FontSize="15" Padding="18,10" VerticalAlignment="Stretch" />
          </Grid>
        </Grid>
        <!-- EDIT — the authoring page: one row per part, per edit and per slot, written straight onto the
             project's own intent. -->
        <views:EditPageView DataContext="{Binding EditPage}"
              IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedStep, Converter={StaticResource StrEq}, ConverterParameter='② Edit'}" />
        <views:BuildPageView DataContext="{Binding BuildPage}"
              IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedStep, Converter={StaticResource StrEq}, ConverterParameter='③ Build'}" />
      </Panel>
    </Grid>

    <!-- ===== Home / start screen (the hub between mods; background scan runs behind it) ===== -->
    <Border Grid.Row="1" IsVisible="{Binding ShowHome}" Background="{StaticResource HudBgBrush}">
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

        <TextBlock Grid.Row="0" Text="DOLL REMOLDING LAB" FontWeight="Bold" FontSize="26"
                   Foreground="{StaticResource HudAccentBrush}" HorizontalAlignment="Center" />
        <TextBlock Grid.Row="1" Margin="0,6,0,28" HorizontalAlignment="Center" TextAlignment="Center"
                   Foreground="{StaticResource HudSubtextBrush}" TextWrapping="Wrap"
                   Text="Start a new mod, or reopen a recent one." />

        <!-- primary actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <Button Content="＋  New mod" Click="OnNewMod" Classes="primary"
                  FontSize="15" Padding="22,12" />
          <Button Content="Open mod…" Click="OnOpenMod" FontSize="15" Padding="22,12" />
        </StackPanel>

        <!-- recent mods -->
        <Border Grid.Row="3" Margin="0,28,0,0" Background="{StaticResource HudPanelBrush}"
                BorderBrush="{StaticResource HudBorderBrush}" BorderThickness="1" CornerRadius="4"
                Padding="16,12" IsVisible="{Binding HasRecentMods}">
          <StackPanel Spacing="8">
            <TextBlock Text="Recent mods" Foreground="{StaticResource HudSubtextBrush}" FontWeight="SemiBold" FontSize="12" />
            <ItemsControl ItemsSource="{Binding RecentMods}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentModVm">
                  <Button Classes="recent" Margin="0,1" Padding="10,7" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenRecentCommand}"
                          CommandParameter="{Binding}">
                    <!-- the thumbnail slot is a FIXED box on every row, held whether or not the mod has a
                         preview, so the names line up down the list. Empty it draws nothing at all — no
                         border, no stand-in. Its height is under the row's own two lines, so a preview
                         never makes a row taller than its neighbours. -->
                    <Grid ColumnDefinitions="Auto,*">
                      <Border Grid.Column="0" Width="56" Height="32" Margin="0,0,10,0"
                              VerticalAlignment="Center" ClipToBounds="True">
                        <Image Source="{Binding Thumb}" Stretch="Uniform" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource HudTextBrush}" FontWeight="SemiBold" />
                        <!-- trimmed, so the full path is on hover: every trimmed label in the app pairs the
                             two -->
                        <TextBlock Text="{Binding Path}" Foreground="{StaticResource HudSubtextBrush}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- background scan progress -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,22,0,0"
                    HorizontalAlignment="Center" IsVisible="{Binding IsScanning}">
          <TextBlock Classes="pulse" Text="◌" />
          <TextBlock Text="{Binding StatusChars}" Foreground="{StaticResource HudSubtextBrush}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Status bar =====
         Grid, not a StackPanel: the roster cell is the single star column that absorbs slack and ellipsizes,
         and every warning/error rides the notice cell (colored glyph + short label, the whole label and its
         detail in the tooltip). Nothing here can run off the right edge — long remedies live in tooltips,
         never inline. Every capped label in the bar binds StatusFacet.Tip rather than .Detail: what the cap
         eats is the tail of the label, so a tooltip that carried the detail alone would drop it. -->
    <Border Grid.Row="2" Background="{StaticResource HudPanelBrush}"
            BorderBrush="{StaticResource HudBorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
        <!-- Game facet -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding GameStatus.Detail}">
          <TextBlock Text="{Binding GameStatus.Glyph}" Foreground="{Binding GameStatus.Color}"
                     IsVisible="{Binding GameStatus.HasGlyph}" />
          <TextBlock Text="{Binding GameStatus.Text}" Foreground="{StaticResource HudSubtextBrush}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="·" Margin="12,0" VerticalAlignment="Center"
                   Foreground="{StaticResource HudBorderBrush}" />
        <!-- Roster cell: the flexible column — trims with an ellipsis, full text in its tooltip -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Classes="pulse" Text="◌" IsVisible="{Binding IsScanning}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusChars}" Foreground="{StaticResource HudSubtextBrush}"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusChars}" />
        </StackPanel>
        <!-- Background-work cell: one line while long disk work runs behind the modder, blank otherwise —
             plus the one ending that is not a blank, a measurement that failed. Running work pulses and
             carries no glyph; the failure carries the ⚠ and its remedy in the tooltip. The label trims at
             180px and eats its own counts doing it, so the tooltip is the only place the whole answer is
             guaranteed to survive: it leads with the line itself and puts the detail under it. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    Margin="12,0,0,0" IsVisible="{Binding BackgroundStatus.HasText}"
                    ToolTip.Tip="{Binding BackgroundStatus.Tip}">
          <TextBlock Classes="pulse" Text="◌" VerticalAlignment="Center"
                     IsVisible="{Binding !BackgroundStatus.HasGlyph}" />
          <TextBlock Text="{Binding BackgroundStatus.Glyph}" Foreground="{Binding BackgroundStatus.Color}"
                     VerticalAlignment="Center" IsVisible="{Binding BackgroundStatus.HasGlyph}" />
          <TextBlock Text="{Binding BackgroundStatus.Text}" Foreground="{StaticResource HudSubtextBrush}"
                     TextTrimming="CharacterEllipsis" MaxWidth="180" />
        </StackPanel>
        <!-- Notice cell: warnings / errors — colored glyph + short label, the label and then the full detail
             in the tooltip, since this label is capped too. Rescan rides the cell only for a load blocked on
             the game, so the remedy its notice names is one click away instead of a Tools-menu trip. -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    Margin="12,0,0,0" IsVisible="{Binding NoticeStatus.HasGlyph}"
                    ToolTip.Tip="{Binding NoticeStatus.Tip}">
          <TextBlock Text="{Binding NoticeStatus.Glyph}" Foreground="{Binding NoticeStatus.Color}" />
          <TextBlock Text="{Binding NoticeStatus.Text}" Foreground="{Binding NoticeStatus.Color}"
                     TextTrimming="CharacterEllipsis" MaxWidth="360" />
          <Button Content="Rescan" Command="{Binding ReloadRosterCommand}"
                  IsVisible="{Binding GameRescanOffered}" Padding="8,1" FontSize="11"
                  VerticalAlignment="Center" />
        </StackPanel>
        <!-- Blender facet -->
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    Margin="12,0,0,0" ToolTip.Tip="{Binding BlenderStatus.Detail}">
          <TextBlock Text="{Binding BlenderStatus.Glyph}" Foreground="{Binding BlenderStatus.Color}"
                     IsVisible="{Binding BlenderStatus.HasGlyph}" />
          <TextBlock Text="{Binding BlenderStatus.Text}" Foreground="{StaticResource HudSubtextBrush}" />
        </StackPanel>
        <!-- 3DMigoto facet: the configured loader. Launch is the only live action that needs
             it, which its tooltip says — nothing else in the app is gated on it. -->
        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    Margin="12,0,0,0" ToolTip.Tip="{Binding MigotoStatus.Detail}">
          <TextBlock Text="{Binding MigotoStatus.Glyph}" Foreground="{Binding MigotoStatus.Color}"
                     IsVisible="{Binding MigotoStatus.HasGlyph}" />
          <TextBlock Text="{Binding MigotoStatus.Text}" Foreground="{StaticResource HudSubtextBrush}" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
